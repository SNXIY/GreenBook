{
  "name": "zhiguang-fe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test:agent-ux": "esbuild tests/agent_projection.test.ts --bundle --platform=node --format=esm | node --input-type=module",
    "test:user-activity": "esbuild tests/user_activity_projection.test.ts --bundle --platform=node --format=esm --loader:.css=text --define:import.meta.env.VITE_GREENBOOK_AGENT_URL=undefined | node --input-type=module",
    "test:execution": "esbuild tests/execution_api_contract.test.ts --bundle --platform=node --format=esm --define:import.meta.env.VITE_GREENBOOK_AGENT_URL=undefined | node --input-type=module",
    "test:conversation-lifecycle": "esbuild tests/conversation_lifecycle.test.ts --bundle --platform=node --format=esm --alias:@=./src | node --input-type=module",
    "test:semantic-confirmation": "esbuild tests/semantic_confirmation_projection.test.ts --bundle --platform=node --format=esm --packages=external --loader:.css=text --loader:.module.css=text --alias:@=./src --define:import.meta.env.VITE_GREENBOOK_AGENT_URL=undefined | node --input-type=module",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.21.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "@types/react": "^18.2.34",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
