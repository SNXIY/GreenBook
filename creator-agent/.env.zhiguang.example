AI_PROVIDER=openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=replace-with-your-model-id

CREATOR_POSTGRES_PASSWORD=replace-with-a-long-compose-password
CREATOR_REDIS_PASSWORD=replace-with-a-different-long-compose-password

CREATOR_API_EXECUTION_MODE=outbox
CREATOR_API_CREATE_SCHEMA=false
CREATOR_API_TENANT_ID=zhiguang

CREATOR_IDENTITY_MODE=trusted_proxy
CREATOR_TRUSTED_PROXY_SHARED_SECRET=replace-with-the-java-creator-agent-secret
CREATOR_TRUSTED_PROXY_ALLOWED_SERVICE=zhiguang-java-backend
CREATOR_TRUSTED_PROXY_TENANT_ID=zhiguang
CREATOR_TRUSTED_PROXY_REQUIRED_ROLE=CREATOR

CREATOR_COMMUNITY_PROVIDER=java
CREATOR_COMMUNITY_JAVA_BASE_URL=http://host.docker.internal:8080
CREATOR_COMMUNITY_JAVA_SHARED_SECRET=replace-with-the-java-community-secret
CREATOR_COMMUNITY_JAVA_SERVICE_NAME=mindflow-creator
CREATOR_COMMUNITY_JAVA_TENANT_ID=zhiguang

CREATOR_PUBLICATION_JAVA_BASE_URL=http://host.docker.internal:8080
CREATOR_PUBLICATION_SHARED_SECRET=change-me-creator-handoff
