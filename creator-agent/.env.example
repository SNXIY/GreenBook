# Local runtime
AI_PROVIDER=deepseek
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=replace-with-your-model-id
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false

# Creator database and LangGraph checkpoints
CREATOR_POSTGRES_PASSWORD=replace-with-a-long-compose-password
CREATOR_REDIS_PASSWORD=replace-with-a-different-long-compose-password
CREATOR_DATABASE_URL=sqlite+aiosqlite:///./data/mindflow-creator.db
CREATOR_CHECKPOINT_BACKEND=sqlite
CREATOR_CHECKPOINT_SQLITE_PATH=data/mindflow-checkpoints.db
CREATOR_CHECKPOINT_POSTGRES_URL=
CREATOR_CHECKPOINT_AUTO_SETUP=true

# API execution: local runs in-process; outbox requires creator-worker
CREATOR_API_EXECUTION_MODE=local
CREATOR_API_CREATE_SCHEMA=true
CREATOR_API_TENANT_ID=tenant-demo
CREATOR_API_WORKER_CONCURRENCY=2
CREATOR_TENANT_MAX_CONCURRENT_RUNS=4
CREATOR_SPECIALIST_TIMEOUT_SECONDS=90
CREATOR_MODEL_TIMEOUT_SECONDS=60
# Optional operation-level model routing; empty values use the provider default.
CREATOR_MODEL_ANALYSIS_MODEL=
CREATOR_MODEL_WRITER_MODEL=
CREATOR_MODEL_CRITIC_MODEL=
CREATOR_MODEL_ASSIST_MODEL=

# OpenTelemetry traces. Prompt, response, material, and draft content are not exported.
CREATOR_OTEL_ENABLED=false
CREATOR_OTEL_SERVICE_NAME=mindflow-creator
CREATOR_OTEL_EXPORTER_ENDPOINT=
CREATOR_OTEL_EXPORTER_HEADERS=

# Development identity
CREATOR_IDENTITY_MODE=basic
CREATOR_BASIC_USERNAME=creator
CREATOR_BASIC_PASSWORD=replace-with-a-local-development-password
CREATOR_BASIC_CREATOR_ID=creator-demo
CREATOR_BASIC_ACTOR_ID=creator-local
CREATOR_BASIC_DISPLAY_NAME=Demo Creator
CREATOR_BASIC_ROLES=CREATOR
CREATOR_LOCAL_AUTO_LOGIN=false

# Java gateway identity (set CREATOR_IDENTITY_MODE=trusted_proxy when integrated)
CREATOR_TRUSTED_PROXY_SHARED_SECRET=
CREATOR_TRUSTED_PROXY_ALLOWED_SERVICE=zhiguang-java-backend
CREATOR_TRUSTED_PROXY_TENANT_ID=zhiguang
CREATOR_TRUSTED_PROXY_REQUIRED_ROLE=CREATOR
CREATOR_TRUSTED_PROXY_ALLOWED_SKEW_SECONDS=60
CREATOR_TRUSTED_PROXY_NONCE_TTL_SECONDS=120

# Production OIDC identity
CREATOR_IDENTITY_ISSUER=
CREATOR_IDENTITY_AUDIENCE=
CREATOR_IDENTITY_JWKS_URL=
CREATOR_IDENTITY_ALGORITHMS=RS256
CREATOR_IDENTITY_TENANT_CLAIM=tenant_id
CREATOR_IDENTITY_CREATOR_CLAIM=creator_id
CREATOR_IDENTITY_ROLES_CLAIM=roles
CREATOR_IDENTITY_DISPLAY_NAME_CLAIM=name
CREATOR_IDENTITY_REQUIRED_ROLE=CREATOR

# Creator Memory
CREATOR_MEMORY_ENABLED=true
CREATOR_SHORT_MEMORY_ENABLED=false
CREATOR_LONG_MEMORY_ENABLED=true
CREATOR_SEMANTIC_MEMORY_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
CREATOR_MEMORY_QDRANT_URL=http://127.0.0.1:6333
CREATOR_MEMORY_QDRANT_COLLECTION=mindflow_creator_memory
CREATOR_MEMORY_EMBEDDING_PROVIDER=hashing
CREATOR_MEMORY_EMBEDDING_DIMENSIONS=256

# Agentic RAG
CREATOR_RETRIEVAL_ENABLED=true
CREATOR_RETRIEVAL_SQL_ENABLED=true
CREATOR_RETRIEVAL_QDRANT_ENABLED=false
CREATOR_RETRIEVAL_QDRANT_URL=http://127.0.0.1:6333
CREATOR_RETRIEVAL_QDRANT_COLLECTION=mindflow_creator_research
CREATOR_RETRIEVAL_RERANKER_PROVIDER=heuristic

# Community data always comes from zhiguang-be.
CREATOR_COMMUNITY_PROVIDER=java
CREATOR_COMMUNITY_JAVA_BASE_URL=http://127.0.0.1:8080
CREATOR_COMMUNITY_JAVA_SHARED_SECRET=
CREATOR_COMMUNITY_JAVA_TENANT_ID=

# Creator worker
CREATOR_WORKER_ID=creator-runtime
CREATOR_WORKER_CONCURRENCY=4
CREATOR_WORKER_BATCH_SIZE=8
CREATOR_WORKER_POLL_SECONDS=0.5
CREATOR_WORKER_OUTBOX_LEASE_SECONDS=300
CREATOR_WORKER_MAX_ATTEMPTS=8

# MCP
CREATOR_MCP_TRANSPORT=stdio
CREATOR_MCP_HOST=127.0.0.1
CREATOR_MCP_PORT=8010
CREATOR_MCP_TENANT_ID=tenant-demo
CREATOR_MCP_CREATOR_ID=creator-demo
CREATOR_MCP_ACTOR_ID=mindflow-mcp
CREATOR_MCP_ROLES=CREATOR
CREATOR_MCP_ALLOWED_TOOLS=
CREATOR_MCP_BEARER_TOKEN=

# Evaluation
CREATOR_EVALUATION_CANDIDATE_NAME=mindflow-creator
CREATOR_EVALUATION_CANDIDATE_VERSION=development
CREATOR_EVALUATION_JUDGE_PROVIDER=deterministic
