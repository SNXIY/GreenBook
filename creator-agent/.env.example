# Local runtime
AI_PROVIDER=deepseek
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=replace-with-your-model-id
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false

# Creator database and LangGraph checkpoints
GREENBOOK_CREATOR_POSTGRES_PASSWORD=replace-with-a-long-compose-password
GREENBOOK_CREATOR_REDIS_PASSWORD=replace-with-a-different-long-compose-password
GREENBOOK_CREATOR_DATABASE_URL=sqlite+aiosqlite:///./data/mindflow-creator.db
GREENBOOK_CREATOR_CHECKPOINT_BACKEND=sqlite
GREENBOOK_CREATOR_CHECKPOINT_SQLITE_PATH=data/mindflow-checkpoints.db
GREENBOOK_CREATOR_CHECKPOINT_POSTGRES_URL=
GREENBOOK_CREATOR_CHECKPOINT_AUTO_SETUP=true

# API execution: local runs in-process; outbox requires creator-worker
GREENBOOK_CREATOR_API_EXECUTION_MODE=local
GREENBOOK_CREATOR_API_CREATE_SCHEMA=true
GREENBOOK_CREATOR_API_TENANT_ID=tenant-demo
GREENBOOK_CREATOR_API_WORKER_CONCURRENCY=2
GREENBOOK_CREATOR_TENANT_MAX_CONCURRENT_RUNS=4
GREENBOOK_CREATOR_SPECIALIST_TIMEOUT_SECONDS=90
GREENBOOK_CREATOR_MODEL_TIMEOUT_SECONDS=60
# Optional operation-level model routing; empty values use the provider default.
GREENBOOK_CREATOR_MODEL_ANALYSIS_MODEL=
GREENBOOK_CREATOR_MODEL_WRITER_MODEL=
GREENBOOK_CREATOR_MODEL_CRITIC_MODEL=
GREENBOOK_CREATOR_MODEL_ASSIST_MODEL=

# OpenTelemetry traces. Prompt, response, material, and draft content are not exported.
GREENBOOK_CREATOR_OTEL_ENABLED=false
GREENBOOK_CREATOR_OTEL_SERVICE_NAME=mindflow-creator
GREENBOOK_CREATOR_OTEL_EXPORTER_ENDPOINT=
GREENBOOK_CREATOR_OTEL_EXPORTER_HEADERS=

# Development identity
GREENBOOK_CREATOR_IDENTITY_MODE=basic
GREENBOOK_CREATOR_BASIC_USERNAME=creator
GREENBOOK_CREATOR_BASIC_PASSWORD=replace-with-a-local-development-password
GREENBOOK_CREATOR_BASIC_CREATOR_ID=creator-demo
GREENBOOK_CREATOR_BASIC_ACTOR_ID=creator-local
GREENBOOK_CREATOR_BASIC_DISPLAY_NAME=Demo Creator
GREENBOOK_CREATOR_BASIC_ROLES=CREATOR
GREENBOOK_CREATOR_LOCAL_AUTO_LOGIN=false

# Java gateway identity (set GREENBOOK_CREATOR_IDENTITY_MODE=trusted_proxy when integrated)
GREENBOOK_CREATOR_TRUSTED_PROXY_SHARED_SECRET=
GREENBOOK_CREATOR_TRUSTED_PROXY_ALLOWED_SERVICE=zhiguang-java-backend
GREENBOOK_CREATOR_TRUSTED_PROXY_TENANT_ID=zhiguang
GREENBOOK_CREATOR_TRUSTED_PROXY_REQUIRED_ROLE=CREATOR
GREENBOOK_CREATOR_TRUSTED_PROXY_ALLOWED_SKEW_SECONDS=60
GREENBOOK_CREATOR_TRUSTED_PROXY_NONCE_TTL_SECONDS=120

# Production OIDC identity
GREENBOOK_CREATOR_IDENTITY_ISSUER=
GREENBOOK_CREATOR_IDENTITY_AUDIENCE=
GREENBOOK_CREATOR_IDENTITY_JWKS_URL=
GREENBOOK_CREATOR_IDENTITY_ALGORITHMS=RS256
GREENBOOK_CREATOR_IDENTITY_TENANT_CLAIM=tenant_id
GREENBOOK_CREATOR_IDENTITY_CREATOR_CLAIM=creator_id
GREENBOOK_CREATOR_IDENTITY_ROLES_CLAIM=roles
GREENBOOK_CREATOR_IDENTITY_DISPLAY_NAME_CLAIM=name
GREENBOOK_CREATOR_IDENTITY_REQUIRED_ROLE=CREATOR

# Creator Memory
GREENBOOK_CREATOR_MEMORY_ENABLED=true
GREENBOOK_CREATOR_SHORT_MEMORY_ENABLED=false
GREENBOOK_CREATOR_LONG_MEMORY_ENABLED=true
GREENBOOK_CREATOR_SEMANTIC_MEMORY_ENABLED=false
GREENBOOK_CREATOR_REDIS_URL=redis://127.0.0.1:6379/0
GREENBOOK_CREATOR_MEMORY_QDRANT_URL=http://127.0.0.1:6333
GREENBOOK_CREATOR_MEMORY_QDRANT_COLLECTION=mindflow_creator_memory
GREENBOOK_CREATOR_MEMORY_EMBEDDING_PROVIDER=hashing
GREENBOOK_CREATOR_MEMORY_EMBEDDING_DIMENSIONS=256

# Agentic RAG
GREENBOOK_CREATOR_RETRIEVAL_ENABLED=true
GREENBOOK_CREATOR_RETRIEVAL_SQL_ENABLED=true
GREENBOOK_CREATOR_RETRIEVAL_QDRANT_ENABLED=false
GREENBOOK_CREATOR_RETRIEVAL_QDRANT_URL=http://127.0.0.1:6333
GREENBOOK_CREATOR_RETRIEVAL_QDRANT_COLLECTION=mindflow_creator_research
GREENBOOK_CREATOR_RETRIEVAL_RERANKER_PROVIDER=heuristic

# Community data always comes from the canonical apps/backend service.
GREENBOOK_CREATOR_COMMUNITY_PROVIDER=java
GREENBOOK_CREATOR_COMMUNITY_JAVA_BASE_URL=http://127.0.0.1:8080
GREENBOOK_CREATOR_COMMUNITY_JAVA_SHARED_SECRET=
GREENBOOK_CREATOR_COMMUNITY_JAVA_TENANT_ID=

# Creator worker
GREENBOOK_CREATOR_WORKER_ID=creator-runtime
GREENBOOK_CREATOR_WORKER_CONCURRENCY=4
GREENBOOK_CREATOR_WORKER_BATCH_SIZE=8
GREENBOOK_CREATOR_WORKER_POLL_SECONDS=0.5
GREENBOOK_CREATOR_WORKER_OUTBOX_LEASE_SECONDS=300
GREENBOOK_CREATOR_WORKER_MAX_ATTEMPTS=8

# MCP
GREENBOOK_CREATOR_MCP_TRANSPORT=stdio
GREENBOOK_CREATOR_MCP_HOST=127.0.0.1
GREENBOOK_CREATOR_MCP_PORT=8010
GREENBOOK_CREATOR_MCP_TENANT_ID=tenant-demo
GREENBOOK_CREATOR_MCP_CREATOR_ID=creator-demo
GREENBOOK_CREATOR_MCP_ACTOR_ID=mindflow-mcp
GREENBOOK_CREATOR_MCP_ROLES=CREATOR
GREENBOOK_CREATOR_MCP_ALLOWED_TOOLS=
GREENBOOK_CREATOR_MCP_BEARER_TOKEN=

# Evaluation
GREENBOOK_CREATOR_EVALUATION_CANDIDATE_NAME=mindflow-creator
GREENBOOK_CREATOR_EVALUATION_CANDIDATE_VERSION=development
GREENBOOK_CREATOR_EVALUATION_JUDGE_PROVIDER=deterministic
