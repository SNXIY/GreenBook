    },
    {
      "chunk_id": "f34febea-ee76-35d4-b4f2-2a54f5c0e356",
      "post_id": "350052643432960000",
      "chunk_index": 16,
      "content": "```java\n@RestController\npublic class HelloController {",
      "event_version": 0,
      "embedding_model": "multilingual-e5-small",
