# API keys for different providers
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
USE_AWS_BEDROCK=false

#Vertex AI
GOOGLE_APPLICATION_CREDENTIALS=

# Set a default model
DEFAULT_MODEL=

# If MODEL is set to "openai-compatible", set the following
# This is just a flexible solution. If you need multiple model options, you still need to add it to models.py
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Web server configuration
HOST=0.0.0.0
PORT=8088

# Authentication secret, HTTP bearer token header is required if set.
# WARNING: If unset, all API endpoints are unauthenticated. Always set this in production.
AUTH_SECRET=

# Langsmith configuration
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=default
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Application mode. If the value is "dev", it will enable uvicorn reload
MODE=

# Database type.
# If the value is "postgres", then it will require Postgresql related environment variables.
# If the value is "sqlite", then you can configure optional file path via SQLITE_DB_PATH
DATABASE_TYPE=

# If DATABASE_TYPE=sqlite (optional). When omitted, checkpoints are stored in
# data/databases/checkpoints.db.
SQLITE_DB_PATH=

# If DATABASE_TYPE=postgres
# Docker Compose default values (will work with docker-compose setup)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_HOST_PORT=5433
POSTGRES_PORT=5433
POSTGRES_DB=

# Content moderation storage. If omitted, POSTGRES_* is reused when
# DATABASE_TYPE=postgres; otherwise data/databases/moderation.db is used locally.
MODERATION_DATABASE_URL=
MODERATION_AUTO_CREATE_SCHEMA=true
MODERATION_SEED_DEFAULT_POLICIES=true
# Risk-adaptive FAST/STANDARD/DEEP routing. FAST can make a direct conservative
# PASS decision; STANDARD uses fixed evidence and one Judge; DEEP keeps the full loop.
MODERATION_ADAPTIVE_CASCADE_ENABLED=true
MODERATION_LOW_RISK_FAST_PATH_ENABLED=true
# Pre-graph cascade: L0 deterministic rules before LangGraph; optional L1 Moderations API.
MODERATION_L0_ENABLED=true
MODERATION_L1_ENABLED=false
MODERATION_L1_BASE_URL=https://api.openai.com/v1
MODERATION_L1_TIMEOUT_SECONDS=5
MODERATION_L1_ENFORCE_SCORE_MIN=0.90
MODERATION_L1_CLEAR_SAFE_SCORE_MAX=0.05
# Build a provenance ledger and deterministically constrain automatic actions.
MODERATION_POLICY_ENGINE_ENABLED=true
MODERATION_PASS_SCORE_MAX=0.20
MODERATION_REJECT_SCORE_MIN=0.80
MODERATION_AUTO_PASS_CONFIDENCE_MIN=0.70
MODERATION_AUTO_REJECT_CONFIDENCE_MIN=0.80
MODERATION_AUTO_LIMIT_CONFIDENCE_MIN=0.80
MODERATION_ADVERSARIAL_SCORE_MIN=0.40
MODERATION_ADVERSARIAL_SCORE_MAX=0.85
MODERATION_ADVERSARIAL_CONFIDENCE_MIN=0.80
MODERATION_ADVERSARIAL_TIMEOUT_SECONDS=30

# Dynamic moderation evidence collection (kept small for DEEP latency).
MODERATION_TOOL_CALLING_ENABLED=true
MODERATION_TOOL_MAX_ROUNDS=2
MODERATION_TOOL_MAX_TOTAL_CALLS=4
MODERATION_TOOL_MAX_PARALLEL_CALLS=3
MODERATION_TOOL_TIMEOUT_SECONDS=5
MODERATION_TOOL_MAX_RESULT_CHARS=4000
MODERATION_TOOL_MAX_RETRIES=1
MODERATION_TOOL_AGENT_TIMEOUT_SECONDS=30

# Agentic Policy RAG is off by default; keyword/DB retrieval remains available.
MODERATION_POLICY_RAG_ENABLED=false
MODERATION_POLICY_RAG_MAX_QUERIES_PER_ROUND=2
MODERATION_POLICY_RAG_MAX_RETRIEVAL_ROUNDS=1
MODERATION_POLICY_RAG_MAX_TOTAL_POLICIES=20
MODERATION_POLICY_RAG_VECTOR_TOP_K=5
MODERATION_POLICY_RAG_KEYWORD_TOP_K=5
MODERATION_POLICY_RAG_FINAL_TOP_K=8
MODERATION_POLICY_RAG_VECTOR_WEIGHT=0.65
MODERATION_POLICY_RAG_KEYWORD_WEIGHT=0.35
MODERATION_POLICY_RAG_MIN_VECTOR_SCORE=0.45
MODERATION_POLICY_RAG_MIN_COMBINED_SCORE=0.50
MODERATION_POLICY_RAG_GRADER_MIN_CONFIDENCE=0.65
MODERATION_POLICY_RAG_ALLOW_PARTIAL=true
MODERATION_POLICY_RAG_FALLBACK_TO_DATABASE=true
MODERATION_POLICY_RAG_AGENT_TIMEOUT_SECONDS=30

# Semantic Evidence Reviewer is off by default (deterministic Policy Engine still runs).
MODERATION_EVIDENCE_REVIEWER_ENABLED=false
MODERATION_REVIEWER_MAX_ITERATIONS=1
MODERATION_REVIEWER_MAX_TOOL_REVISIONS=0
MODERATION_REVIEWER_MAX_POLICY_REVISIONS=0
MODERATION_REVIEWER_MAX_JUDGMENT_REVISIONS=1
MODERATION_REVIEWER_MIN_CONFIDENCE=0.65
MODERATION_REVIEWER_HUMAN_ON_BUDGET=true
MODERATION_REVIEWER_HUMAN_ON_ERROR=true
MODERATION_REVIEWER_ALLOW_FAST_PATH_ON_ERROR=false
MODERATION_REVIEWER_TIMEOUT_SECONDS=30
MODERATION_GRAPH_RECURSION_LIMIT=64
# Async accept + DB-claim worker. Set false to run the graph inside create_task (tests/debug).
MODERATION_ASYNC_ENABLED=true
# Start a poller inside the API process. Set false when running a dedicated moderation_worker.
MODERATION_EMBEDDED_WORKER_ENABLED=true
MODERATION_WORKER_POLL_INTERVAL_MS=500
MODERATION_WORKER_LEASE_SECONDS=300
MODERATION_WORKER_CONCURRENCY=2
# MODERATION_WORKER_ID=

# Human-review queue index. PostgreSQL remains the source of truth when Redis is absent.
REDIS_URL=
MODERATION_REDIS_QUEUE_KEY=moderation:review:pending

# Policy and reviewed-case vector retrieval. Database retrieval is used when absent.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_POLICY_COLLECTION=moderation_policies
QDRANT_CASE_COLLECTION=moderation_review_cases
MODERATION_VECTOR_SIZE=256

# Community context provider. Switch to java without changing Agent tools or graph state.
# For GreenBook fusion with zhiguang-be:
COMMUNITY_PROVIDER=java
JAVA_COMMUNITY_BASE_URL=http://127.0.0.1:8080
JAVA_COMMUNITY_AUTH_TOKEN=
COMMUNITY_HTTP_TIMEOUT=10

# Name shown for this service in PostgreSQL connection managers.
# POSTGRES_APPLICATION_NAME=content-moderation-platform
# set these values to customize the number of connections in the pool. Saver and store have independent connection pools
POSTGRES_MIN_CONNECTIONS_PER_POOL=1
POSTGRES_MAX_CONNECTIONS_PER_POOL=5

# Add for running ollama
# OLLAMA_MODEL=llama3.2
# Note: set OLLAMA_BASE_URL if running service in docker and ollama on bare metal
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Add for running Azure OpenAI
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
# Azure deployment names must match the selected model value, such as azure-gpt-5-mini.
