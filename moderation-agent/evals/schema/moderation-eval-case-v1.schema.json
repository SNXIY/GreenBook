{
  "$defs": {
    "EvalAnnotation": {
      "additionalProperties": false,
      "properties": {
        "adjudicator_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 3,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjudicator Id"
        },
        "agreement": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agreement"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "reviewer_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$",
            "type": "string"
          },
          "maxItems": 10,
          "title": "Reviewer Ids",
          "type": "array"
        },
        "source": {
          "$ref": "#/$defs/EvalCaseSource"
        },
        "status": {
          "$ref": "#/$defs/EvalAnnotationStatus",
          "default": "UNLABELED"
        }
      },
      "required": [
        "source"
      ],
      "title": "EvalAnnotation",
      "type": "object"
    },
    "EvalAnnotationStatus": {
      "enum": [
        "UNLABELED",
        "PROPOSED",
        "REVIEWED",
        "ADJUDICATED"
      ],
      "title": "EvalAnnotationStatus",
      "type": "string"
    },
    "EvalCaseSource": {
      "enum": [
        "POLICY_TEMPLATE",
        "LLM_GENERATED",
        "CURATED_SEED",
        "HUMAN_REVIEW",
        "REVIEW_OVERRIDE"
      ],
      "title": "EvalCaseSource",
      "type": "string"
    },
    "EvalContext": {
      "additionalProperties": false,
      "properties": {
        "author_recent_contents": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Author Recent Contents",
          "type": "array"
        },
        "complete": {
          "default": true,
          "title": "Complete",
          "type": "boolean"
        },
        "conversation_context": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Conversation Context",
          "type": "array"
        },
        "parent_comment": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Comment"
        },
        "report_reasons": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Report Reasons",
          "type": "array"
        }
      },
      "title": "EvalContext",
      "type": "object"
    },
    "EvalDatasetSplit": {
      "enum": [
        "UNASSIGNED",
        "DEVELOPMENT",
        "CALIBRATION",
        "TEST",
        "CHALLENGE"
      ],
      "title": "EvalDatasetSplit",
      "type": "string"
    },
    "EvalEvidenceField": {
      "enum": [
        "CONTENT",
        "PARENT_COMMENT",
        "CONVERSATION_CONTEXT",
        "AUTHOR_RECENT_CONTENT",
        "REPORT_REASON"
      ],
      "title": "EvalEvidenceField",
      "type": "string"
    },
    "EvalEvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "field": {
          "$ref": "#/$defs/EvalEvidenceField",
          "default": "CONTENT"
        },
        "source_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Index"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "EvalEvidenceSpan",
      "type": "object"
    },
    "EvalInput": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "content_type": {
          "$ref": "#/$defs/ModerationContentType",
          "default": "TEXT"
        },
        "context": {
          "$ref": "#/$defs/EvalContext"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 30,
          "title": "Metadata",
          "type": "object"
        },
        "platform": {
          "default": "default",
          "maxLength": 64,
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "EvalInput",
      "type": "object"
    },
    "EvalLabel": {
      "additionalProperties": false,
      "properties": {
        "acceptable_actions": {
          "items": {
            "$ref": "#/$defs/ModerationAction"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Acceptable Actions",
          "type": "array"
        },
        "evidence_spans": {
          "items": {
            "$ref": "#/$defs/EvalEvidenceSpan"
          },
          "maxItems": 20,
          "title": "Evidence Spans",
          "type": "array"
        },
        "expected_action": {
          "$ref": "#/$defs/ModerationAction"
        },
        "policy_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Policy Codes",
          "type": "array"
        },
        "primary_risk_type": {
          "$ref": "#/$defs/RiskType"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "requires_human_review": {
          "default": false,
          "title": "Requires Human Review",
          "type": "boolean"
        },
        "risk_labels": {
          "items": {
            "$ref": "#/$defs/RiskType"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Risk Labels",
          "type": "array"
        }
      },
      "required": [
        "primary_risk_type",
        "risk_labels",
        "expected_action",
        "acceptable_actions",
        "policy_codes",
        "reason"
      ],
      "title": "EvalLabel",
      "type": "object"
    },
    "EvalPolicyReference": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Z0-9_-]+$",
          "title": "Code",
          "type": "string"
        },
        "fingerprint_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint Sha256"
        },
        "version": {
          "default": "1",
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "EvalPolicyReference",
      "type": "object"
    },
    "EvalPolicySnapshot": {
      "additionalProperties": false,
      "properties": {
        "policies": {
          "items": {
            "$ref": "#/$defs/EvalPolicyReference"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Policies",
          "type": "array"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 3,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "policies"
      ],
      "title": "EvalPolicySnapshot",
      "type": "object"
    },
    "EvalPrivacyDeclaration": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/EvalPrivacyMode",
          "default": "NO_SENSITIVE_DATA"
        },
        "notes": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "synthetic_sensitive_values": {
          "items": {
            "maxLength": 256,
            "minLength": 3,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Synthetic Sensitive Values",
          "type": "array"
        }
      },
      "title": "EvalPrivacyDeclaration",
      "type": "object"
    },
    "EvalPrivacyMode": {
      "enum": [
        "NO_SENSITIVE_DATA",
        "SYNTHETIC_ONLY",
        "PRODUCTION_REDACTED"
      ],
      "title": "EvalPrivacyMode",
      "type": "string"
    },
    "ModerationAction": {
      "enum": [
        "PASS",
        "REJECT",
        "LIMIT",
        "HUMAN_REVIEW"
      ],
      "title": "ModerationAction",
      "type": "string"
    },
    "ModerationContentType": {
      "enum": [
        "TEXT",
        "POST",
        "COMMENT"
      ],
      "title": "ModerationContentType",
      "type": "string"
    },
    "RiskType": {
      "enum": [
        "NORMAL",
        "ADVERTISING",
        "ABUSE",
        "PRIVACY"
      ],
      "title": "RiskType",
      "type": "string"
    }
  },
  "$id": "urn:content-moderation:schemas:moderation-eval-case:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation": {
      "$ref": "#/$defs/EvalAnnotation"
    },
    "case_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "title": "Case Id",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/EvalInput"
    },
    "label": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvalLabel"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "policy_snapshot": {
      "$ref": "#/$defs/EvalPolicySnapshot"
    },
    "privacy": {
      "$ref": "#/$defs/EvalPrivacyDeclaration"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "scenario_group_id": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "title": "Scenario Group Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "$ref": "#/$defs/EvalDatasetSplit",
      "default": "UNASSIGNED"
    },
    "tags": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "case_id",
    "scenario_group_id",
    "input",
    "annotation",
    "policy_snapshot"
  ],
  "title": "ModerationEvalCase",
  "type": "object"
}
