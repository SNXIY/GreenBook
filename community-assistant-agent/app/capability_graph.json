{
  "version": "greenbook-capabilities-v2",
  "capabilities": [
    {"name": "analysis", "description": "Analyze authorized community data.", "aliases": ["analytics", "data_analysis"]},
    {"name": "trend_analysis", "description": "Analyze topic and content trends.", "implies": ["analysis"], "aliases": ["trend"]},
    {"name": "user_insight", "description": "Analyze community users and interaction behavior.", "implies": ["analysis"], "aliases": ["user_analysis", "user_insights"]},
    {"name": "search", "description": "Search authorized community content.", "aliases": ["retrieval", "search_posts"]},
    {"name": "read_post", "description": "Read an authorized community post."},
    {"name": "summarize", "description": "Summarize authorized evidence.", "aliases": ["summary", "summarization"]},
    {"name": "generation", "description": "Generate a community content draft.", "aliases": ["generate", "content_generation", "create_content"]},
    {"name": "rewrite_content", "description": "Rewrite an existing content draft.", "implies": ["generation"], "aliases": ["draft_revision", "revise_draft", "content_edit"]},
    {"name": "publishing", "description": "Publish an authorized draft.", "aliases": ["publish", "publication"]},
    {"name": "schedule_publish", "description": "Schedule an authorized draft for publication.", "implies": ["publishing"], "aliases": ["schedule", "scheduling", "scheduled_publish", "schedule_update", "update_schedule", "reschedule"]},
    {"name": "comment_interaction", "description": "Interact through community comments.", "aliases": ["comment", "reply_comment"]},
    {"name": "list_own_content", "description": "List content owned by the current user."},
    {"name": "delete_content", "description": "Delete authorized user-owned content."},
    {"name": "external_research", "description": "Read from an explicitly allowed external source."},
    {"name": "mcp_tool", "description": "Invoke an explicitly allowlisted MCP tool."}
  ]
}
