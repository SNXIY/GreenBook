# ===== GreenBook monorepo (.env) =====
# Used by root docker-compose.yml and local IDE runs.

# --- Host port map (do not change casually) ---
# zhiguang-mysql 33306 | shared-postgres 25432 | shared-redis 26379 | kafka 39092
# qdrant 26333/26334 | agent 8094 | fe 5173 | be 8080

# --- zhiguang-fe ---
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_GREENBOOK_AGENT_URL=/agent-api
VITE_GREENBOOK_AGENT_PROXY_TARGET=http://127.0.0.1:8094

# --- optional live E2E account (dedicated USER account; never commit real values) ---
GREENBOOK_E2E_IDENTIFIER_TYPE=EMAIL
GREENBOOK_E2E_IDENTIFIER=
GREENBOOK_E2E_PASSWORD=

# --- apps/backend (host Java Backend + Docker infra) ---
ZHIGUANG_MYSQL_HOST_PORT=33306
ZHIGUANG_KAFKA_HOST_PORT=39092
GREENBOOK_POSTGRES_HOST_PORT=25432
GREENBOOK_REDIS_HOST_PORT=26379
QDRANT_HTTP_HOST_PORT=26333
QDRANT_GRPC_HOST_PORT=26334
ZHIGUANG_MYSQL_PASSWORD=123456
ZHIGUANG_MYSQL_DB=zhiguang
GREENBOOK_POSTGRES_USER=mindflow
GREENBOOK_POSTGRES_PASSWORD=mindflow
GREENBOOK_REDIS_PASSWORD=mindflow
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33306
MYSQL_DB=zhiguang
MYSQL_USER=root
MYSQL_PASSWORD=123456
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
REDIS_PASSWORD=mindflow
REDIS_DATABASE=1
KAFKA_HOST=127.0.0.1
KAFKA_PORT=39092
CANAL_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
GREENBOOK_AGENT_MODEL_FAST=deepseek-v4-flash
GREENBOOK_AGENT_MODEL_STRONG=deepseek-v4-pro
GREENBOOK_AGENT_MODEL_JUDGE=deepseek-v4-pro
GREENBOOK_AGENT_MODEL_FAST_THINKING=false
GREENBOOK_AGENT_MODEL_STRONG_THINKING=true
GREENBOOK_AGENT_MODEL_JUDGE_THINKING=false
GREENBOOK_AGENT_MODEL_STRONG_REASONING_EFFORT=high
GREENBOOK_AGENT_MODEL_FAST_TIMEOUT_SECONDS=25
GREENBOOK_AGENT_MODEL_STRONG_TIMEOUT_SECONDS=90
GREENBOOK_AGENT_MODEL_JUDGE_TIMEOUT_SECONDS=45
GREENBOOK_AGENT_MODEL_FAILURE_THRESHOLD=2
GREENBOOK_AGENT_MODEL_COOLDOWN_SECONDS=30
GREENBOOK_AGENT_MODEL_ROUTE_OVERRIDES_JSON={}
DEFAULT_MODEL=deepseek-v4-flash
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_PUBLIC_DOMAIN=
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=http://127.0.0.1:8080
GREENBOOK_JAVA_PUBLIC_BASE_URL=http://127.0.0.1:8080
GREENBOOK_JAVA_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STORAGE_PROVIDER=local

GREENBOOK_AGENT_SERVICE_SHARED_SECRET=change-me-agent-service

# --- GreenBook Agent Runtime ---
GREENBOOK_AGENT_API_PORT=8094
GREENBOOK_MCP_PORT=8095
GREENBOOK_BUSINESS_MCP_BASE_URL=http://127.0.0.1:8095/mcp
# Production/default: every active business Tool uses the MCP boundary.
# Set to "local" only for an isolated test/development process.
GREENBOOK_MCP_TRANSPORT=mcp
GREENBOOK_MCP_RUNTIME_TOKEN=change-me-mcp-runtime
GREENBOOK_MCP_TIMEOUT_SECONDS=30
GREENBOOK_AGENT_DATABASE_URL=postgresql+asyncpg://mindflow:mindflow@127.0.0.1:25432/mindflow_creator
# Runtime production profile: API and standalone worker share these durable stores.
GREENBOOK_AGENT_RUNTIME_STORAGE=postgres
GREENBOOK_AGENT_RUNTIME_DATABASE_URL=${GREENBOOK_AGENT_DATABASE_URL}
GREENBOOK_AGENT_EXECUTION_DISPATCH=queue
# Single-process development: run the execution queue consumer inside the API
# process. Production keeps an external worker and sets a shared token that the
# queue handler presents when fetching broker-issued credentials.
GREENBOOK_AGENT_IN_PROCESS_WORKER=true
GREENBOOK_AGENT_WORKER_ACCESS_TOKEN=change-me-agent-worker
# New messages always use Immediate Accept: persist Run, return 202, then let
# the bounded AgentRunner execute in the background.
# Bounded control-plane and execution concurrency. Waiting-for-user/approval
# work does not consume these slots.
GREENBOOK_AGENT_MAX_CONCURRENT_RUNS=4
GREENBOOK_AGENT_MAX_CONCURRENT_RUNS_PER_CONVERSATION=2
GREENBOOK_AGENT_MAX_CONCURRENT_WORK_PER_CONVERSATION=3
GREENBOOK_AGENT_MAX_CONCURRENT_DIRECT_TOOLS=6
GREENBOOK_AGENT_EXECUTION_WORKER_CONCURRENCY=4
GREENBOOK_AGENT_CONTINUATION_CONCURRENCY=4
GREENBOOK_AGENT_EXECUTION_QUEUE_CONSUMER=true
GREENBOOK_AGENT_WORKER_HEALTH_FILE=.runtime/agent-worker-health.json
GREENBOOK_AGENT_WORKER_HEALTH_INTERVAL_SECONDS=15
GREENBOOK_AGENT_WORKER_HEALTH_MAX_AGE_SECONDS=90
# Canonical local service URLs used by the Phase15-A environment checker.
GREENBOOK_JAVA_BASE_URL=http://127.0.0.1:8080
GREENBOOK_JAVA_CONNECT_TIMEOUT_SECONDS=5
GREENBOOK_JAVA_READ_TIMEOUT_SECONDS=30
GREENBOOK_JAVA_WRITE_TIMEOUT_SECONDS=30
GREENBOOK_JAVA_POOL_TIMEOUT_SECONDS=5
GREENBOOK_JAVA_MAX_CONNECTIONS=20
GREENBOOK_JAVA_MAX_KEEPALIVE=10
GREENBOOK_JAVA_VERIFY_TLS=true
GREENBOOK_AGENT_IDENTITY_ISSUER=http://127.0.0.1:8080
GREENBOOK_AGENT_IDENTITY_AUDIENCE=greenbook-agent-runtime
GREENBOOK_AGENT_IDENTITY_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json
GREENBOOK_AGENT_ALLOW_INSECURE_HTTP=true
GREENBOOK_AGENT_PROCESS_ROLE=all
GREENBOOK_AGENT_RUN_CONCURRENCY=4
GREENBOOK_AGENT_SCHEDULER_CONCURRENCY=2
GREENBOOK_AGENT_TOOL_JOB_CONCURRENCY=2
GREENBOOK_AGENT_MAX_CONCURRENT_RUNS_PER_USER=1
GREENBOOK_AGENT_MAX_CONCURRENT_READ_RUNS_PER_USER=3
GREENBOOK_AGENT_TOOL_JOB_LEASE_SECONDS=90
GREENBOOK_AGENT_TOOL_JOB_MAX_ATTEMPTS=4
GREENBOOK_AGENT_TOOL_JOB_POLL_SECONDS=0.8
GREENBOOK_AGENT_EVENT_STREAM_POLL_SECONDS=1
# Tool Runtime HTTP transport (default: do not inherit process HTTP_PROXY)
GREENBOOK_AGENT_TOOL_HTTP_TRUST_ENV=false
GREENBOOK_AGENT_TOOL_HTTP_PROXY=
GREENBOOK_AGENT_TOOL_HTTP_CONNECT_TIMEOUT_SECONDS=5
GREENBOOK_AGENT_TOOL_HTTP_READ_TIMEOUT_SECONDS=30
GREENBOOK_AGENT_TOOL_HTTP_POOL_TIMEOUT_SECONDS=5
GREENBOOK_AGENT_TOOL_HTTP_VERIFY_TLS=true
GREENBOOK_AGENT_MODEL_REQUESTS_PER_MINUTE=60
GREENBOOK_AGENT_USER_MODEL_REQUESTS_PER_MINUTE=12
GREENBOOK_AGENT_MAX_MODEL_CALLS=6
GREENBOOK_AGENT_MAX_TOOL_CALLS=30
GREENBOOK_AGENT_MAX_REPLANS=2
GREENBOOK_AGENT_MAX_RUN_ATTEMPTS=3
GREENBOOK_AGENT_MAX_ITERATIONS=24
GREENBOOK_AGENT_RUN_TIMEOUT_SECONDS=600
GREENBOOK_AGENT_PUBLICATION_MIN_LEAD_SECONDS=15
GREENBOOK_AGENT_PUBLICATION_MAX_SCHEDULE_DAYS=6
GREENBOOK_AGENT_DELETION_BATCH_CHUNK_SIZE=20
GREENBOOK_AGENT_CONVERSATION_CONTEXT_MAX_CHARS=16000
GREENBOOK_AGENT_TOOL_CONTEXT_MAX_CHARS=24000
GREENBOOK_AGENT_POST_CONTEXT_MAX_CHARS=32000
GREENBOOK_AGENT_MEMORY_CONTEXT_MAX_CHARS=6000
GREENBOOK_AGENT_EPISODIC_MEMORY_ENABLED=true
GREENBOOK_AGENT_EPISODIC_MEMORY_RETENTION_DAYS=180
GREENBOOK_AGENT_EPISODIC_MEMORY_RECALL_LIMIT=5
# "hashing" is deterministic local feature hashing, not a mock model.
# For model-level semantic similarity use "openai" and configure the fields below.
GREENBOOK_AGENT_MEMORY_EMBEDDING_PROVIDER=hashing
GREENBOOK_AGENT_MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
GREENBOOK_AGENT_MEMORY_EMBEDDING_API_KEY=
GREENBOOK_AGENT_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
GREENBOOK_AGENT_MEMORY_EMBEDDING_DIMENSIONS=256
GREENBOOK_AGENT_MEMORY_SEMANTIC_SCORE_THRESHOLD=0.18
GREENBOOK_AGENT_APPROVAL_TTL_MINUTES=30
# Optional MCP servers. Tools are deny-by-default and must be listed explicitly.
# Example: [{"name":"research","url":"http://127.0.0.1:9000/mcp","allowed_tools":["search"]}]
GREENBOOK_AGENT_MCP_SERVERS_JSON=[]
GREENBOOK_AGENT_MCP_MAX_RESULT_CHARS=24000
