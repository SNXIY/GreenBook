# ===== GreenBook monorepo (.env) =====
# Used by root docker-compose.yml and local IDE runs.

# --- Host port map (do not change casually) ---
# zhiguang-mysql 33306 | shared-postgres 25432 | shared-redis 26379 | kafka 39092
# qdrant 26333/26334 | creator 8092 | moderation 8088 | assistant 8094 | fe 5173 | be 8080

# --- zhiguang-fe ---
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_CREATOR_STUDIO_URL=http://127.0.0.1:8092/creator.html
VITE_CREATOR_AGENT_URL=/creator-agent
VITE_ASSISTANT_AGENT_URL=/assistant-agent

# --- optional live E2E account (dedicated USER account; never commit real values) ---
GREENBOOK_E2E_IDENTIFIER_TYPE=EMAIL
GREENBOOK_E2E_IDENTIFIER=
GREENBOOK_E2E_PASSWORD=

# --- zhiguang-be (host IDE → docker infra) ---
ZHIGUANG_MYSQL_HOST_PORT=33306
ZHIGUANG_KAFKA_HOST_PORT=39092
GREENBOOK_POSTGRES_HOST_PORT=25432
GREENBOOK_REDIS_HOST_PORT=26379
QDRANT_HTTP_HOST_PORT=26333
QDRANT_GRPC_HOST_PORT=26334
ZHIGUANG_MYSQL_PASSWORD=123456
ZHIGUANG_MYSQL_DB=zhiguang
GREENBOOK_POSTGRES_USER=mindflow
GREENBOOK_POSTGRES_PASSWORD=mindflow
GREENBOOK_REDIS_PASSWORD=mindflow
MYSQL_HOST=127.0.0.1
MYSQL_PORT=33306
MYSQL_DB=zhiguang
MYSQL_USER=root
MYSQL_PASSWORD=123456
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
REDIS_PASSWORD=mindflow
REDIS_DATABASE=1
KAFKA_HOST=127.0.0.1
KAFKA_PORT=39092
CANAL_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
ASSISTANT_MODEL_FAST=deepseek-v4-flash
ASSISTANT_MODEL_STRONG=deepseek-v4-pro
ASSISTANT_MODEL_JUDGE=deepseek-v4-pro
ASSISTANT_MODEL_FAST_THINKING=false
ASSISTANT_MODEL_STRONG_THINKING=true
ASSISTANT_MODEL_JUDGE_THINKING=false
ASSISTANT_MODEL_STRONG_REASONING_EFFORT=high
ASSISTANT_MODEL_FAST_TIMEOUT_SECONDS=25
ASSISTANT_MODEL_STRONG_TIMEOUT_SECONDS=90
ASSISTANT_MODEL_JUDGE_TIMEOUT_SECONDS=45
ASSISTANT_MODEL_FAILURE_THRESHOLD=2
ASSISTANT_MODEL_COOLDOWN_SECONDS=30
ASSISTANT_MODEL_ROUTE_OVERRIDES_JSON={}
DEFAULT_MODEL=deepseek-v4-flash
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=
OSS_PUBLIC_DOMAIN=
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=http://127.0.0.1:8080
JAVA_PUBLIC_BASE_URL=http://127.0.0.1:8080
JAVA_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STORAGE_PROVIDER=local

CREATOR_HANDOFF_SHARED_SECRET=change-me-creator-handoff
CREATOR_AGENT_SHARED_SECRET=change-me-creator-proxy
ASSISTANT_SERVICE_SHARED_SECRET=change-me-assistant-service

# --- creator-agent ---
AI_PROVIDER=deepseek
CREATOR_IDENTITY_MODE=oidc
CREATOR_IDENTITY_AUDIENCE=creator-agent
CREATOR_API_PORT=8092
CREATOR_WORKER_CONCURRENCY=4
CREATOR_TENANT_MAX_CONCURRENT_RUNS=4
CREATOR_USER_MAX_CONCURRENT_RUNS=1
CREATOR_POSTGRES_DB=mindflow_creator
CREATOR_IDENTITY_ISSUER=http://127.0.0.1:8080
CREATOR_IDENTITY_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json
CREATOR_IDENTITY_ALLOW_INSECURE_HTTP=true
CREATOR_COMMUNITY_SHARED_SECRET=change-me-creator-proxy
CREATOR_COMMUNITY_PROVIDER=java
CREATOR_COMMUNITY_JAVA_BASE_URL=http://127.0.0.1:8080
CREATOR_PUBLICATION_JAVA_BASE_URL=http://127.0.0.1:8080
CREATOR_PUBLICATION_SHARED_SECRET=change-me-creator-handoff

# --- community-assistant-agent (reuses Creator PostgreSQL) ---
ASSISTANT_API_PORT=8094
ASSISTANT_DATABASE_URL=postgresql+asyncpg://mindflow:mindflow@127.0.0.1:25432/mindflow_creator
# Runtime production profile: API and standalone worker share these durable stores.
ASSISTANT_RUNTIME_STORAGE=postgres
ASSISTANT_RUNTIME_DATABASE_URL=${ASSISTANT_DATABASE_URL}
ASSISTANT_EXECUTION_DISPATCH=queue
ASSISTANT_EXECUTION_QUEUE_CONSUMER=true
ASSISTANT_WORKER_HEALTH_FILE=.runtime/assistant-worker-health.json
ASSISTANT_WORKER_HEALTH_INTERVAL_SECONDS=15
ASSISTANT_WORKER_HEALTH_MAX_AGE_SECONDS=90
ASSISTANT_JAVA_BASE_URL=http://127.0.0.1:8080
ASSISTANT_CREATOR_BASE_URL=http://127.0.0.1:8092
ASSISTANT_JAVA_CONNECT_TIMEOUT_SECONDS=5
ASSISTANT_JAVA_READ_TIMEOUT_SECONDS=30
ASSISTANT_JAVA_WRITE_TIMEOUT_SECONDS=30
ASSISTANT_JAVA_POOL_TIMEOUT_SECONDS=5
ASSISTANT_JAVA_MAX_CONNECTIONS=20
ASSISTANT_JAVA_MAX_KEEPALIVE=10
ASSISTANT_JAVA_VERIFY_TLS=true
ASSISTANT_CREATOR_TIMEOUT_SECONDS=240
ASSISTANT_CREATOR_POLL_INTERVAL_SECONDS=1.5
ASSISTANT_IDENTITY_ISSUER=http://127.0.0.1:8080
ASSISTANT_IDENTITY_AUDIENCE=community-assistant-agent
ASSISTANT_IDENTITY_JWKS_URL=http://127.0.0.1:8080/.well-known/jwks.json
ASSISTANT_ALLOW_INSECURE_HTTP=true
ASSISTANT_PROCESS_ROLE=all
ASSISTANT_RUN_CONCURRENCY=4
ASSISTANT_SCHEDULER_CONCURRENCY=2
ASSISTANT_TOOL_JOB_CONCURRENCY=2
ASSISTANT_MAX_CONCURRENT_RUNS_PER_USER=1
ASSISTANT_MAX_CONCURRENT_READ_RUNS_PER_USER=3
ASSISTANT_TOOL_JOB_LEASE_SECONDS=90
ASSISTANT_TOOL_JOB_MAX_ATTEMPTS=4
ASSISTANT_TOOL_JOB_POLL_SECONDS=0.8
ASSISTANT_CREATOR_DEPENDENCY_POLL_SECONDS=30
ASSISTANT_EVENT_STREAM_POLL_SECONDS=1
# Tool Runtime HTTP transport (default: do not inherit process HTTP_PROXY)
ASSISTANT_TOOL_HTTP_TRUST_ENV=false
ASSISTANT_TOOL_HTTP_PROXY=
ASSISTANT_TOOL_HTTP_CONNECT_TIMEOUT_SECONDS=5
ASSISTANT_TOOL_HTTP_READ_TIMEOUT_SECONDS=30
ASSISTANT_TOOL_HTTP_POOL_TIMEOUT_SECONDS=5
ASSISTANT_TOOL_HTTP_VERIFY_TLS=true
ASSISTANT_REDIS_URL=redis://:mindflow@127.0.0.1:26379/0
ASSISTANT_DISTRIBUTED_LIMITS_ENABLED=true
ASSISTANT_DISTRIBUTED_LIMITS_REQUIRED=false
ASSISTANT_MODEL_REQUESTS_PER_MINUTE=60
ASSISTANT_USER_MODEL_REQUESTS_PER_MINUTE=12
ASSISTANT_MAX_MODEL_CALLS=6
ASSISTANT_MAX_TOOL_CALLS=30
ASSISTANT_MAX_REPLANS=2
ASSISTANT_MAX_RUN_ATTEMPTS=3
ASSISTANT_RUN_TIMEOUT_SECONDS=600
ASSISTANT_PUBLICATION_MIN_LEAD_SECONDS=15
ASSISTANT_PUBLICATION_MAX_SCHEDULE_DAYS=6
ASSISTANT_DELETION_BATCH_CHUNK_SIZE=20
ASSISTANT_CONVERSATION_CONTEXT_MAX_CHARS=16000
ASSISTANT_TOOL_CONTEXT_MAX_CHARS=24000
ASSISTANT_POST_CONTEXT_MAX_CHARS=32000
ASSISTANT_MEMORY_CONTEXT_MAX_CHARS=6000
ASSISTANT_EPISODIC_MEMORY_ENABLED=true
ASSISTANT_EPISODIC_MEMORY_RETENTION_DAYS=180
ASSISTANT_EPISODIC_MEMORY_RECALL_LIMIT=5
ASSISTANT_SEMANTIC_MEMORY_ENABLED=true
ASSISTANT_SEMANTIC_MEMORY_REQUIRED=false
ASSISTANT_MEMORY_QDRANT_URL=http://127.0.0.1:26333
ASSISTANT_MEMORY_QDRANT_COLLECTION=greenbook_assistant_memory
# "hashing" is deterministic local feature hashing, not a mock model.
# For model-level semantic similarity use "openai" and configure the fields below.
ASSISTANT_MEMORY_EMBEDDING_PROVIDER=hashing
ASSISTANT_MEMORY_EMBEDDING_BASE_URL=https://api.openai.com/v1
ASSISTANT_MEMORY_EMBEDDING_API_KEY=
ASSISTANT_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
ASSISTANT_MEMORY_EMBEDDING_DIMENSIONS=256
ASSISTANT_MEMORY_SEMANTIC_SCORE_THRESHOLD=0.18
ASSISTANT_APPROVAL_TTL_MINUTES=30
# Optional MCP servers. Tools are deny-by-default and must be listed explicitly.
# Example: [{"name":"research","url":"http://127.0.0.1:9000/mcp","allowed_tools":["search"]}]
ASSISTANT_MCP_SERVERS_JSON=[]
ASSISTANT_MCP_MAX_RESULT_CHARS=24000

# --- moderation-agent ---
MODERATION_API_PORT=8088
COMMUNITY_PROVIDER=java
JAVA_COMMUNITY_BASE_URL=http://127.0.0.1:8080
MODERATION_POSTGRES_DB=content_moderation
MODERATION_CALLBACK_CONCURRENCY=2
MODERATION_CALLBACK_POLL_SECONDS=0.5
MODERATION_CALLBACK_LEASE_SECONDS=30
MODERATION_CALLBACK_MAX_ATTEMPTS=8
MODERATION_CALLBACK_RETRY_BASE_SECONDS=2
MODERATION_CALLBACK_RETRY_MAX_SECONDS=300
